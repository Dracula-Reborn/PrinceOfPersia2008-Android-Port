+bool SharedMemory::ForceReuploadRange(u32 start, u32 length) {
+  if (!length || start >= kBufferSize) {
+    return true;
+  }
+  const u32 max_len = kBufferSize - start;
+  const u32 clamped_length = (length < max_len) ? length : max_len;
+  const u32 page_first = start >> page_size_log2_;
+  const u32 page_last = (start + clamped_length - 1u) >> page_size_log2_;
+  for (u32 page = page_first; page <= page_last; ++page) {
+    const size_t block = static_cast<size_t>(page >> 6);
+    const u64 bit = static_cast<u64>(1) << (page & 63u);
+    if (block < system_page_flags_valid_.size()) {
+      system_page_flags_valid_[block] &= ~bit;
+      system_page_flags_valid_and_gpu_written_[block] &= ~bit;
+    }
+  }
+  return RequestRange(start, clamped_length);
+}
