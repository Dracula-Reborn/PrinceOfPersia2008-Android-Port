+  if (st.pfn_get_data(st.dev, st.cache, &sz, nullptr) != VK_SUCCESS || sz == 0 || sz > 64u * 1024u * 1024u) {
+    return;
+  }
+  std::vector<uint8_t> data(sz);
+  if (st.pfn_get_data(st.dev, st.cache, &sz, data.data()) != VK_SUCCESS || sz == 0) {
+    return;
+  }
